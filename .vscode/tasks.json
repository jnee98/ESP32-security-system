{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP-IDF: Build",
            "type": "shell",
            "command": "idf.py",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build ESP-IDF project",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "IDF_PATH": "${config:esp-idf.idfPath}",
                    "PATH": "${config:esp-idf.idfToolPath}/tools/riscv32-esp-elf/esp-13.2.0_20240530/riscv32-esp-elf/bin;${config:esp-idf.idfToolPath}/tools/cmake/3.24.0/bin;${config:esp-idf.idfToolPath}/tools/ninja/1.11.1;${config:esp-idf.idfToolPath}/tools/ccache/4.8/ccache-4.8-windows-x86_64;${env:PATH}"
                }
            }
        },
        {
            "label": "ESP-IDF: Flash",
            "type": "shell",
            "command": "idf.py",
            "args": ["flash"],
            "group": "test",
            "detail": "Flash ESP-IDF project to device"
        },
        {
            "label": "ESP-IDF: Monitor",
            "type": "shell",
            "command": "idf.py",
            "args": ["monitor"],
            "group": "test",
            "detail": "Open serial monitor"
        },
        {
            "label": "ESP-IDF: Flash and Monitor",
            "type": "shell",
            "command": "idf.py",
            "args": ["flash", "monitor"],
            "group": "test",
            "detail": "Flash and open serial monitor"
        },
        {
            "label": "ESP-IDF: Menuconfig",
            "type": "shell",
            "command": "idf.py",
            "args": ["menuconfig"],
            "group": "test",
            "detail": "Open menuconfig"
        },
        {
            "label": "ESP-IDF: Clean",
            "type": "shell",
            "command": "idf.py",
            "args": ["fullclean"],
            "group": "build",
            "detail": "Clean build artifacts"
        }
    ]
}